# Copy to ~/.config/it-gateway/env (mode 600); deploy/run.sh reads it at start-up.
# Required
MIMIR_API_KEY=sk-...
MIMIR_ANTHROPIC_URL=https://mimir.example/anthropic   # Mimir's Anthropic-compatible endpoint
# Optional
# IT_ROUTER_PORT=4000
# IT_ROUTER_LOG=/path/to/it-router.jsonl             # default ~/Library/Logs/it-router.jsonl
