# Copy to ~/.config/it-gateway/env (mode 600); deploy/run.sh reads it at start-up.
# Required
MIMIR_API_KEY=sk-...
# Which Mimir API to use: openai (/v1, translated) or anthropic (/anthropic, passed through; the default)
MIMIR_API=openai
MIMIR_OPENAI_URL=https://mimir.example/v1              # with MIMIR_API=openai
# MIMIR_ANTHROPIC_URL=https://mimir.example/anthropic  # with MIMIR_API=anthropic
# Optional
# IT_ROUTER_PORT=4000
# IT_ROUTER_LOG=/path/to/it-router.jsonl               # default ~/Library/Logs/it-router.jsonl
