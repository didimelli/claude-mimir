#!/bin/bash
# Claude Code routed through the local router (port 4000), for sessions that use the Mimir subagents
# (it-implementer-mimir-*, mimir, mimir-pro, mimir-slim). Plain `claude` goes straight to Anthropic.
# The router sends cubbit/* to Mimir and everything else to Anthropic untouched; it needs no extra headers.
# Needs the gateway running: curl -s http://127.0.0.1:4000/router/health
export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
unset ANTHROPIC_CUSTOM_HEADERS
exec claude "$@"
